{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PerformanceAnalyzerOutput",
  "type": "object",
  "required": [
    "summary",
    "averageWatchTime",
    "completionRate",
    "dropoffAt2s",
    "overallScore",
    "diagnosis",
    "actionableTips"
  ],
  "properties": {
    "summary": { "type": "string" },
    "averageWatchTime": { "type": "string" },
    "completionRate": { "type": "string" },
    "dropoffAt2s": { "type": "string" },
    "overallScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "diagnosis": { "type": "string" },
    "actionableTips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "text"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
