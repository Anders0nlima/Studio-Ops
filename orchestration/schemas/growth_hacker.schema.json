{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GrowthHackerOutput",
  "type": "object",
  "required": [
    "title",
    "description",
    "callToActionQuestion",
    "hashtags",
    "suggestedAudioVibe",
    "retentionStrategyTip"
  ],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 100
    },
    "description": { "type": "string" },
    "callToActionQuestion": { "type": "string" },
    "hashtags": {
      "type": "array",
      "minItems": 4,
      "maxItems": 12,
      "items": { "type": "string" }
    },
    "suggestedAudioVibe": { "type": "string" },
    "retentionStrategyTip": { "type": "string" }
  }
}
