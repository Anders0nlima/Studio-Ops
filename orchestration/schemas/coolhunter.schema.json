{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoolhunterOutput",
  "type": "object",
  "required": ["trends"],
  "properties": {
    "trends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tag",
          "topic",
          "growth",
          "color",
          "insight",
          "visualStyleRecommended",
          "retentionScore",
          "hookIdea"
        ],
        "properties": {
          "id": { "type": "string" },
          "tag": { "type": "string" },
          "topic": { "type": "string" },
          "growth": { "type": "string" },
          "color": {
            "type": "string",
            "enum": ["cyan", "pink", "purple", "amber"]
          },
          "insight": { "type": "string" },
          "visualStyleRecommended": { "type": "string" },
          "retentionScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "hookIdea": { "type": "string" }
        }
      }
    }
  }
}
